{
    "parallel": false,
    "use": {
        "list":     "Dm.Web.BuildStatic.Stages.Files.FilesSource",
        "eachFile": "Dm.Web.BuildStatic.Stages.Files.EachFileCopy",
        "minjs":    "Dm.Web.BuildStatic.Stages.JS.MinifyJS",
        "minjssrc": "Dm.Web.BuildStatic.Stages.JS.MinifyJSSource",
        "gzip":     "Dm.Web.BuildStatic.Stages.Compress.GzipStream",
		"sprite":   "Dm.Web.BuildStatic.Stages.SVG.SVGSprite",
        "svg2mjs":  "Dm.Web.BuildStatic.Stages.SVG.SVGtoJS",
        "vue2mjs":  "Dm.Web.BuildStatic.Stages.JS.VueToJS"
    },
    "pipelines": [
        {
            "list":  "TestStatic/js/**/*.js",
            "list":  "TestStatic/js/**/*.mjs",
            "eachFile": {
                "@dst":  "{path}.gz",
                "gzip":  "Optimal",
                "minjs": null
            }
        },
        {
            "list":  "TestStatic/vue/*.vue",
            "eachFile": {
                "@dst":    "{path}.mjs.gz",
                "gzip":    null,
                "vue2mjs": {
                    "js":  "minjssrc"
                }
            }
        },
        {
            "list": "TestStatic/css/*.css",
            "eachFile": {
                "@dst": "{path}.gz",
                "gzip": null
            }
        },
        {
            "list":  "TestStatic/move-to-js.txt",
            "eachFile":  {
                "@dst":  "TestStatic/js/moved.js.gz",
                "gzip":  null,
                "minjs": null
            }
        },
        {
            "list":   "TestStatic/img/oauth2-icons/*.svg",
			"sprite": "TestStatic/img/oauth2-icons.mjs.gz",
			"gzip":    null,
            "svg2mjs": null
        }
    ]
}